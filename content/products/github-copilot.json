  "overview": {
    "text": "GitHub Copilotは、コードの記述やタスクの自動化をAIで支援する開発ツールです。提供元はMicrosoftおよびGitHubです。",
    "sources": [
      "github-copilot-native-app-released",
      "github-copilot-security-extension"
    ]
  },
  "facts": [
    {
      "label": "料金",
      "value": "既存のCopilot契約内",
      "sources": [
        "github-copilot-jetbrains-air",
        "github-copilot-security-extension"
      ]
    },
    {
      "label": "提供開始",
      "value": "2026年9月（アプリ一般提供）",
      "sources": [
        "github-copilot-native-app-released"
      ]
    },
    {
      "label": "日本での提供",
      "value": "利用できる",
      "sources": [
        "github-copilot-jetbrains-air",
        "github-copilot-security-extension"
      ]
    },
    {
      "label": "使える場所",
      "value": "Windows、Mac、IDE、クラウド",
      "sources": [
        "github-copilot-jetbrains-air",
        "github-copilot-native-app-released"
      ]
    },
    {
      "label": "向いている人",
      "value": "開発者や法務などの担当者",
      "sources": [
        "github-copilot-native-app-released",
        "github-copilot-security-extension"
      ]
    }
  ],
  "capabilities": [
    {
      "text": "チャット画面や専用画面からコードのセキュリティ脆弱性を確認し、修正を依頼できます。",
      "sources": [
        "github-copilot-security-extension"
      ]
    },
    {
      "text": "独立したワークツリーを使い、開発中のコードと衝突させずにAIがIssuesやPRを自動処理します。",
      "sources": [
        "github-copilot-native-app-released"
      ]
    },
    {
      "text": "フロンティア級LLMの「Kimi K3」など、タスクに応じて複数のモデルを動的に選択できます。",
      "sources": [
        "github-copilot-kimi-k3-multi-agent"
      ]
    },
    {
      "text": "JetBrainsのIDE上やクラウド上の隔離環境で、Copilotに作業を任せられます。",
      "sources": [
        "github-copilot-jetbrains-air"
      ]
    }
  ],
  "pricing": [
    {
      "text": "セキュリティ拡張機能自体の利用に追加料金はかかりません。任意のCopilotプランで利用できます。",
      "sources": [
        "github-copilot-security-extension"
      ]
    }
  ],
  "japan": [
    {
      "text": "日本のユーザーも今日から利用可能です。",
      "sources": [
        "github-copilot-security-extension"
      ]
    },
    {
      "text": "Copilot自体は日本でも使え、日本語の公式ドキュメントもあります。",
      "sources": [
        "github-copilot-jetbrains-air"
      ]
    }
  ],
  "howto": [
    {
      "text": "WindowsやMac向けのスタンドアロンアプリをダウンロードし、有効なアカウントでログインします。",
      "sources": [
        "github-copilot-native-app-released"
      ]
    },
    {
      "text": "セキュリティ拡張機能は、ターミナルでインストールコマンドを実行するか、アプリの画面から追加できます。",
      "sources": [
        "github-copilot-security-extension"
      ]
    }
  ],
  "differences": [
    {
      "text": "従来のIDEプラグインの枠組みを超え、OS上で直接動作するスタンドアロンアプリとして利用できるようになりました。",
      "sources": [
        "github-copilot-native-app-released"
      ]
    }
  ],
  "faq": [
    {
      "q": "どのようなプランが必要？",
      "a": "有効な有料のCopilot契約が必要です。",
      "sources": [
        "github-copilot-native-app-released"
      ]
    },
    {
      "q": "追加のモデルは使える？",
      "a": "Kimi K3などのフロンティア級LLMがモデル選択肢に追加されています。",
      "sources": [
        "github-copilot-kimi-k3-multi-agent"
      ]
    },
    {
      "q": "対応しているOSは何？",
      "a": "WindowsおよびmacOSに対応しています。",
      "sources": [
        "github-copilot-native-app-released"
      ]
    },
    {
      "q": "コード以外の業務にも使える？",
      "a": "GitHub社の法務チームでも日常業務に利用されています。",
      "sources": [
        "github-copilot-native-app-released"
      ]
    }
  ],
