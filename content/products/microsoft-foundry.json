  "howto": [
    {
      "text": "ポータルサイト（ai.azure.com）にアクセスし、アカウントでサインインします。",
      "sources": [
        "microsoft-foundry-agent-tutorial-azure"
      ]
    },
    {
      "text": "Azureサブスクリプションを登録してアカウントを連携させると利用を開始できます。",
      "sources": [
        "microsoft-foundry-agent-tutorial-azure"
      ]
    },
    {
      "text": "画面上のメニューから新しいAIエージェントを作成し、Playgroundで挙動を確認します。",
      "sources": [
        "microsoft-foundry-agent-tutorial-azure"
      ]
    }
  ],
  "differences": [
    {
      "text": "従来の個別モデルデプロイから、単一エンドポイントで複数モデルへ自動ルーティングする機能へ拡張されました。",
      "sources": [
        "microsoft-foundry-model-router-update"
      ]
    },
    {
      "text": "実行部分がRustに移植され、セッションごとの負荷や最初の応答までの時間が軽減されました。",
      "sources": [
        "microsoft-copilot-harness-foundry"
      ]
    }
  ],
  "faq": [
    {
      "q": "無料で使える？",
      "a": "登録時に200ドル分の無料クレジットが付与されるため、費用をかけずに初期テストを進められます。",
      "sources": [
        "microsoft-foundry-agent-tutorial-azure"
      ]
    },
    {
      "q": "どんなモデルが使える？",
      "a": "OpenAIのGPTやAnthropicのClaudeなど、多様なモデルが揃っています。",
      "sources": [
        "microsoft-foundry-complete-agent-platform-guide-matome",
        "microsoft-foundry-agent-tutorial-azure"
      ]
    },
    {
      "q": "作ったエージェントは公開できる？",
      "a": "画面上のPublishボタンからWebアプリとしてすぐに公開できます。",
      "sources": [
        "microsoft-foundry-agent-tutorial-azure"
      ]
    },
    {
      "q": "安全対策の機能はある？",
      "a": "脱獄や情報漏洩を遮断するGuardrails機能や、安全なデータアクセスを行うMCP接続規格を利用できます。",
      "sources": [
        "microsoft-foundry-complete-agent-platform-guide-matome"
      ]
    }
