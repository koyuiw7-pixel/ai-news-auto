      ]
    }
  ],
  "capabilities": [
    {
      "text": "複数LLMを難易度に応じて動的に振り分けるModel Router機能があります。",
      "sources": [
        "microsoft-foundry-complete-agent-platform-guide-matome",
        "microsoft-foundry-model-router-update"
      ]
    },
    {
      "text": "エージェントの実行環境やループ制御を自動提供するCopilot harnessを利用可能です。",
      "sources": [
        "microsoft-foundry-complete-agent-platform-guide-matome",
        "microsoft-foundry-agent-service-copilot-harness"
      ]
    },
    {
      "text": "画面上の設定だけで指示文の調整やツール連携を行えるPlaygroundで事前テストができます。",
      "sources": [
        "microsoft-foundry-agent-playground-test"
      ]
    },
    {
      "text": "MCP接続規格により、社内データや外部ツールと安全に連携できます。",
      "sources": [
        "microsoft-foundry-complete-agent-platform-guide-matome",
        "microsoft-foundry-agent-tutorial-azure"
      ]
    },
    {
      "text": "GUI操作で脱獄や個人情報漏洩を遮断するGuardrails機能を使えます。",
      "sources": [
        "microsoft-foundry-complete-agent-platform-guide-matome"
      ]
    }
  ],
  "pricing": [
    {
      "text": "アカウント登録時に200ドル分の無料クレジットが付与され、初期テストを進められます。",
      "sources": [
        "microsoft-foundry-agent-tutorial-azure"
      ]
    },
    {
      "text": "動画生成AIモデルでは、1秒あたりの従量課金制が採用されています。",
