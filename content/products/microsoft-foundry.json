  "overview": {
    "text": "Microsoft Foundryは、AIモデルの選定やエージェント作成を行えるプラットフォームです。Microsoftが提供し、2026年8月から11月にかけて機能が発表されました。",
    "sources": [
      "microsoft-foundry-complete-agent-platform-guide-matome",
      "microsoft-foundry-agent-tutorial-azure"
    ]
  },
  "facts": [
    {
      "label": "料金",
      "value": "Azure従量課金、無料枠あり",
      "sources": [
        "microsoft-foundry-agent-playground-test",
        "microsoft-foundry-agent-tutorial-azure"
      ]
    },
    {
      "label": "日本での提供",
      "value": "利用できる",
      "sources": [
        "microsoft-foundry-agent-playground-test",
        "microsoft-foundry-agent-tutorial-azure"
      ]
    },
    {
      "label": "向いている人",
      "value": "AIエージェントの開発者",
      "sources": [
        "microsoft-foundry-agent-playground-test",
        "microsoft-foundry-agent-tutorial-azure"
      ]
    }
  ],
  "capabilities": [
    {
      "text": "モデルカタログから主要モデルを同一画面で切り替えて比較検証できます。",
      "sources": [
        "microsoft-foundry-agent-tutorial-azure"
      ]
    },
    {
      "text": "画面上の設定だけでエージェントの指示文調整や応答確認を行えます。",
      "sources": [
        "microsoft-foundry-agent-playground-test"
      ]
    },
    {
      "text": "複数の大規模言語モデルを単一のAPIエンドポイントから自動的に振り分けられます。",
      "sources": [
        "microsoft-foundry-model-router-update"
      ]
    },
    {
      "text": "コンテナ構築不要でエージェントを実行できるCopilot harnessを利用できます。",
      "sources": [
        "microsoft-foundry-complete-agent-platform-guide-matome",
        "microsoft-foundry-agent-service-copilot-harness"
      ]
    },
    {
      "text": "文章や画像から動画を作る5つの動画生成AIモデルを利用できます。",
      "sources": [
        "microsoft-foundry-video-models-fal"
      ]
    }
  ],
  "pricing": [
    {
      "text": "登録時には200ドル分の無料クレジットが付与されます。",
      "sources": [
        "microsoft-foundry-agent-tutorial-azure"
      ]
    },
    {
      "text": "動画生成AIは1秒あたりの単価で利用できます。最安は0.025ドルです。",
      "sources": [
        "microsoft-foundry-video-models-fal"
      ]
    }
  ],
  "japan": [
    {
      "text": "日本国内から利用できます。",
      "sources": [
        "microsoft-foundry-agent-playground-test",
        "microsoft-foundry-agent-tutorial-azure"
      ]
    }
  ],
  "howto": [
    {
      "text": "ポータルサイトにアクセスし、Azureサブスクリプションを登録します。",
      "sources": [
        "microsoft-foundry-complete-agent-platform-guide-matome",
        "microsoft-foundry-agent-tutorial-azure"
      ]
    },
    {
      "text": "画面上の「Build an agent」から新しいAIエージェントを作成できます。",
      "sources": [
        "microsoft-foundry-agent-tutorial-azure"
      ]
    }
  ],
  "differences": [
    {
      "text": "従来はモデルの切り替えやインフラ構築を自前で行う必要がありました。",
      "sources": [
        "microsoft-foundry-complete-agent-platform-guide-matome"
      ]
    }
  ],
  "faq": [
    {
      "q": "無料で使える？",
      "a": "登録時に200ドル分の無料クレジットが付与され、初期テストを進められます。",
      "sources": [
        "microsoft-foundry-agent-tutorial-azure"
      ]
    },
    {
      "q": "どのようなモデルが選べる？",
