# これを .env.local にコピーして値を入れる（.env.local は git 管理外）
# API キー取得: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 使用モデル（省略時は gemini-3.5-flash → 3.6-flash → flash-latest の順に自動フォールバック）
# GEMINI_MODEL=gemini-3.6-flash

# 本番ドメイン（Vercel の環境変数に設定すると sitemap / OGP の絶対URLが正しくなる）
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
