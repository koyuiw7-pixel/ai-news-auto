{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saisoku-site",
  // OpenNext の出力を包み、記事 JSON を静的アセットから先読みする入口
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // 記事の元データは公開しない（worker が 404 を返す。env.ASSETS からは読める）
    "run_worker_first": ["/_content/*"]
  },
  "observability": { "enabled": true },
  // エッジキャッシュのキーにデプロイの版を入れる（cloudflare/worker.ts）
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://ai-tech-express.jp",
    // ASP の表示回数ピクセルを本番として出す（components/rail/parts.tsx などが見ている）
    "VERCEL_ENV": "production",
    // メール配信（lib/newsletter）。送信の鍵 CF_EMAIL_TOKEN / RESEND_API_KEY は wrangler secret put で入れる
    "CLOUDFLARE_ACCOUNT_ID": "51e37d82e15d397b9666dc3d09bd5b92",
    "NEWSLETTER_FROM": "news@ai-tech-express.jp"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "saisoku-site" }],
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "15923fe8d91c4b3e8557971d9393656f" },
    // メール購読者（ダブルオプトイン・解除トークン・連投制限）。lib/newsletter/store.ts
    { "binding": "NEWSLETTER_KV", "id": "d0108c8275074124b8fdfbd577111999" },
    // 記事の写真（フリー素材・AI 生成）。scripts/images.py が書き、cloudflare/worker.ts の /img/<名前> が配信する
    { "binding": "IMAGES_KV", "id": "358e46161fdb4857865dec69dd72285b" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }]
}
